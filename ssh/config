# Machine-specific overrides (IdentityFile, etc.) — not tracked in the repo.
# Included first so its values win (ssh uses the first value seen per option).
Include ~/.ssh/config.local

Host github.com
  HostName github.com
  User git
  AddKeysToAgent yes

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
